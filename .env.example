# Vercel / Cashfree Payment Gateway Credentials
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
CASHFREE_ENV=PROD # Use 'PROD' for Live Payment or 'TEST' for Sandbox
CASHFREE_WEBHOOK_SECRET=your_webhook_secret_optional

# Vercel / Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_optional

# Vercel / ZapUPI Payment Gateway Credentials (https://zapupi.com)
ZAPUPI_TOKEN_KEY=your_zapupi_token_key
ZAPUPI_SECRET_KEY=your_zapupi_secret_key
